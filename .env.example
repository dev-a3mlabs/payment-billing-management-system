PORT=5000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/payment_billing"

# Used only by `npx prisma db seed` to create the first super_admin_main
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password"
SUPER_ADMIN_FIRST_NAME="Super"

# Use long random values (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_TEMP_SECRET="replace-with-different-long-random-string"
JWT_TEMP_EXPIRES_IN="15m"
