PORT=5000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/payment_billing"

# Used only by `npx prisma db seed` to create the first super admin
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password"
SUPER_ADMIN_FIRST_NAME="Super"

# Use long random values (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
SESSION_MAX_HOURS=12

# Proxies in front of the app: 1 on Railway, loopback locally (ngrok)
TRUST_PROXY="loopback"

# Fingerprint.com dashboard → App settings → API keys (Secret key). Region: global | eu | ap
FINGERPRINT_SECRET_API_KEY="replace-with-fingerprint-secret-key"
FINGERPRINT_REGION="ap"
0Pm5lSF7tKJACpvpCjWK

# Encrypts MFA secrets. 32 random bytes as hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MFA_ENCRYPTION_KEY="replace-with-64-hex-characters"
