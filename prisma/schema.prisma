generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  super_admin
  admin
  agent
  user
}

enum UserStatus {
  active
  inactive
  suspended
  deleted
}

model User {
  id                 Int        @id @default(autoincrement())
  uuid               String     @unique @default(uuid())
  username           String     @unique
  email              String?    @unique
  passwordHash       String     @map("password_hash")
  role               Role
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(true) @map("must_change_password")

  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  countryCode  String? @map("country_code")
  mobileNumber String? @map("mobile_number")

  createdById  Int?   @map("created_by_id")
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  parentId Int?   @map("parent_id")
  parent   User?  @relation("UserParent", fields: [parentId], references: [id])
  children User[] @relation("UserParent")

  createdUsers User[] @relation("UserCreatedBy")

  sessions    UserSession[]
  loginEvents LoginEvent[]
  security    UserSecurity?

  activitiesAsActor  ActivityLog[] @relation("ActivityActor")
  activitiesAsTarget ActivityLog[] @relation("ActivityTarget")

  accessValues      AccessUserValue[] @relation("AccessUserValueUser")
  accessUserUpdates AccessUserValue[] @relation("AccessUserValueUpdatedBy")
  accessRoleUpdates AccessRoleValue[]

  tempPasswordUsedAt DateTime? @map("temp_password_used_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  lastLoginAt        DateTime? @map("last_login_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([countryCode, mobileNumber])
  @@index([role])
  @@index([createdById])
  @@index([parentId])

  @@map("users")
}

model RefreshToken {
  id        Int         @id @default(autoincrement())
  sessionId Int         @map("session_id")
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at")
  revokedAt DateTime?   @map("revoked_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum AccessKind {
  permission
  limit
  policy
}

enum AccessValueType {
  bool
  int
  string
}

model AccessKey {
  id           Int             @id @default(autoincrement())
  key          String          @unique @db.VarChar(100)
  module       String          @db.VarChar(50)
  kind         AccessKind
  valueType    AccessValueType @map("value_type")
  defaultValue String          @map("default_value") @db.VarChar(255)
  description  String?
  createdAt    DateTime        @default(now()) @map("created_at")

  roleValues AccessRoleValue[]
  userValues AccessUserValue[]

  @@index([module])
  @@map("access_keys")
}

model AccessRoleValue {
  role        Role
  accessKeyId Int       @map("access_key_id")
  accessKey   AccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)
  value       String    @db.VarChar(255)
  updatedById Int       @map("updated_by_id")
  updatedBy   User      @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([role, accessKeyId])
  @@index([accessKeyId])
  @@index([updatedById])
  @@map("access_role_values")
}

model AccessUserValue {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation("AccessUserValueUser", fields: [userId], references: [id], onDelete: Cascade)
  accessKeyId Int       @map("access_key_id")
  accessKey   AccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)
  value       String    @db.VarChar(255)
  updatedById Int       @map("updated_by_id")
  updatedBy   User      @relation("AccessUserValueUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, accessKeyId])
  @@index([accessKeyId])
  @@index([updatedById])
  @@map("access_user_values")
}

model UserSession {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal       String    @db.VarChar(30)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  visitorId    String?   @map("visitor_id") @db.VarChar(64)
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  loginEvents   LoginEvent[]

  @@index([userId, revokedAt])
  @@index([userId, visitorId])
  @@map("user_sessions")
}

enum LoginStatus {
  success
  failed
  blocked
}

model UserSecurity {
  userId              Int       @id @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")
  lockedAt            DateTime? @map("locked_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([lockedAt])
  @@map("user_security")
}

model LoginEvent {
  id          BigInt       @id @default(autoincrement())
  userId      Int          @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   Int?         @map("session_id")
  session     UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  portal      String       @db.VarChar(30)
  status      LoginStatus
  blockReason String?      @map("block_reason") @db.VarChar(50)

  requestIp String? @map("request_ip") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  eventId        String?  @unique @map("event_id") @db.VarChar(64)
  visitorId      String?  @map("visitor_id") @db.VarChar(64)
  fingerprintIp  String?  @map("fingerprint_ip") @db.VarChar(45)
  os             String?  @db.VarChar(50)
  browserName    String?  @map("browser_name") @db.VarChar(50)
  countryCode    String?  @map("country_code") @db.Char(2)
  city           String?  @db.VarChar(100)
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  browserDetails Json?    @map("browser_details")
  ipInfo         Json?    @map("ip_info")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([visitorId])
  @@index([createdAt])
  @@map("login_events")
}

enum ActivityStatus {
  success
  failed
}

model ActivityLog {
  id           BigInt         @id @default(autoincrement())
  actorId      Int?           @map("actor_id")
  actor        User?          @relation("ActivityActor", fields: [actorId], references: [id])
  targetUserId Int?           @map("target_user_id")
  targetUser   User?          @relation("ActivityTarget", fields: [targetUserId], references: [id])
  sessionId    Int?           @map("session_id")
  session      UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  action       String         @db.VarChar(100)
  status       ActivityStatus
  entityType   String?        @map("entity_type") @db.VarChar(50)
  entityId     String?        @map("entity_id") @db.VarChar(64)
  ipAddress    String?        @map("ip_address") @db.VarChar(45)
  userAgent    String?        @map("user_agent") @db.VarChar(512)
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([sessionId])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
